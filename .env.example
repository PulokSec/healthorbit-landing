# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Email (SMTP) ---
# Production: Hostinger's SMTP relay. Use the full mailbox address as
# SMTP_USER and its mailbox password as SMTP_PASSWORD.
#   Hostinger: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SECURE=true
#              SMTP_USER=no-reply@yourdomain.com  SMTP_PASSWORD=<mailbox password>
#   Port 465 with SMTP_SECURE=true is the reliable option; Hostinger's port
#   587 (STARTTLS) intermittently fails with "wrong version number".
#
# Local dev: points at Mailpit by default. Run `docker compose up -d`, then
# see every email the site sends at http://localhost:8025. Mailpit needs no
# auth, so leave SMTP_USER/SMTP_PASSWORD blank.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown on every email. With Hostinger this must be SMTP_USER's mailbox.
SMTP_FROM="HealthOrbit <no-reply@healthorbit.com>"

# Team inbox that receives form enquiries (comma-separate several).
# Replies to these emails go straight to the patient.
EMAIL_TEAM_TO="bd@healthorbit.com"

# Absolute site URL, used for the logo and links inside emails.
SITE_URL="http://localhost:3000"
