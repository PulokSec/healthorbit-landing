# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Email (SMTP) ---
# Production: Hostinger's SMTP relay. Each form logs in as its own mailbox
# (EMAIL_INFO_ADDRESS / EMAIL_CARE_ADDRESS below); both share SMTP_PASSWORD.
#   Hostinger: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SECURE=true
#              SMTP_PASSWORD=<mailbox password>
#   Port 465 with SMTP_SECURE=true is the reliable option; Hostinger's port
#   587 (STARTTLS) intermittently fails with "wrong version number".
#
# Local dev: points at Mailpit by default. Run `docker compose up -d`, then
# see every email the site sends at http://localhost:8025. Mailpit needs no
# auth, so leave SMTP_PASSWORD blank.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_PASSWORD=""

# Each mailbox is both the From address and the SMTP login for its form.
#   info: the contact page's consultation form
#   care: enquiries from hospital pages
# Every team notification, from either form, is delivered to EMAIL_CARE_ADDRESS.
# Replies to those emails go straight to the patient.
EMAIL_FROM_NAME="HealthOrbit"
EMAIL_INFO_ADDRESS="info@healthorbit.support"
EMAIL_CARE_ADDRESS="care@healthorbit.support"

# Absolute site URL, used for the logo and links inside emails.
SITE_URL="http://localhost:3000"
